# Everything works without these. Set them only to try the optional real-model path.
# Install the extra dependency first: pip install -r requirements-llm.txt

# Any LiteLLM model string, e.g. anthropic/claude-haiku-5-5 or gpt-4o-mini
LITELLM_MODEL=
# The provider key LiteLLM expects for that model, e.g.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# How many cases to send to the model per prompt version (keeps cost small)
LLM_SAMPLE=10
